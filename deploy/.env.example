# Copia a deploy/.env y rellena. Nunca subas el .env al repo.
# Genera MASTER_KEY y VAPID con:  cd proxy && node scripts/gen-keys.mjs

# Dominio público (DNS apuntando al VPS). Caddy saca el certificado solo.
DOMAIN=multichat.example.com
PUBLIC_URL=https://multichat.example.com

# 32 bytes en hex. Cifra credenciales de bots y firma sesiones. Si se pierde, hay que reconfigurar bots y volver a iniciar sesión.
MASTER_KEY=

MAX_INTEGRATIONS_PER_USER=20
WHATSAPP_GRAPH_VERSION=v23.0
# Servir la PWA en /app (build de web/ montado en /web)
SERVE_WEB_DIR=/web

# Push iOS (clave .p8 de la cuenta de Apple Developer de DOTRINO S.A.S.)
APNS_KEY_FILE=/run/secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=P7G853375S
APNS_TOPIC=com.dotrino.multichat

# Web Push (PWA)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
